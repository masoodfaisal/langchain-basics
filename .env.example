LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_TRACING=true
LANGSMITH_PROJECT="YOUR-APP-NAME"
# Testing workspace
LANGSMITH_WORKSPACE_ID=WORKSPACE_ID
OPENAI_BASE_URL=<<YOUR OPENAI API URL
EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5
EMBEDDING_CACHE_DIR=.cache/fastembed
MODEL_NAME=
LANGSMITH_DEPLOYMENT_NAME='langchain-basics'
# Stamped on every root run as metadata.environment (e.g. staging, production).
APP_ENVIRONMENT=staging
# Set LANGSMITH_API_KEY in your shell, not here.
# Set OPENAI_API_KEY in your shell, not here.